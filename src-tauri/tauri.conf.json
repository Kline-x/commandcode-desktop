{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Command Code",
  "version": "0.0.1",
  "identifier": "com.commandcode.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Command Code",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Command Code 多账号代理与用量面板",
    "longDescription": "为任意 OpenAI / Anthropic 兼容客户端提供本地端点，自动轮换多个 Command Code 账号，并实时展示额度用量。"
  }
}
